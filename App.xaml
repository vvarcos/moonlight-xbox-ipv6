<Application
    x:Class="moonlight_xbox_dx.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:moonlight_xbox_dx">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ============================================================
                 Paleta
                 ============================================================ -->
            <Color x:Key="AccentColor">#FF8FA9FF</Color>
            <Color x:Key="AccentColor2">#FFB79CFF</Color>

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF5F7FF" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF9FAAC7" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#FF6C7793" />

            <SolidColorBrush x:Key="AccentBrush" Color="#FF8FA9FF" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#382F4BFF" />

            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#26FFFFFF" />
            <SolidColorBrush x:Key="SubtleDividerBrush" Color="#1AFFFFFF" />

            <!-- Fundo: gradiente escuro (azul-noite -> roxo) -->
            <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF070A12" Offset="0.0" />
                <GradientStop Color="#FF0F1626" Offset="0.45" />
                <GradientStop Color="#FF191231" Offset="1.0" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#FF8FA9FF" Offset="0.0" />
                <GradientStop Color="#FFB79CFF" Offset="1.0" />
            </LinearGradientBrush>

            <!-- ============================================================
                 Estados dos itens de lista (hover / pressionado)
                 ============================================================ -->
            <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="#22FFFFFF" />

            <!-- ============================================================
                 Tipografia
                 ============================================================ -->
            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="CaptionStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="CardTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>

            <!-- ============================================================
                 Cartao e botoes
                 ============================================================ -->
            <Style x:Key="HostCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="Padding" Value="18" />
                <Setter Property="Width" Value="264" />
                <Setter Property="MinHeight" Value="286" />
            </Style>

            <Style x:Key="AppTileCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="10" />
            </Style>

            <Style x:Key="AppTileTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="MaxWidth" Value="164" />
            </Style>

            <Style x:Key="IconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="48" />
                <Setter Property="Height" Value="48" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
